# Copy to .env.pilot (ignored); do not commit secrets. No trailing slash on origin.
APP_ENV=staging
PUBLIC_PILOT=true
PUBLIC_BASE_URL=https://pending-tunnel.invalid
# Required by the production base file, unused for pilot HTTP routing.
AEVYRA_DOMAIN=unused.invalid
CORS_ORIGINS=[]
IMAGE_TAG=pilot
POSTGRES_USER=aevyra
POSTGRES_DB=aevyra
POSTGRES_PASSWORD=REPLACE_WITH_SECURE_DATABASE_PASSWORD
DATABASE_URL=postgresql+psycopg://aevyra:REPLACE_WITH_SECURE_DATABASE_PASSWORD@postgres:5432/aevyra
REDIS_URL=redis://redis:6379/0
API_URL=http://api:8000
REDEMPTION_CODE_PEPPER=REPLACE_WITH_SECURE_RANDOM_SECRET
PAYMENT_PROVIDER=mock
LOG_LEVEL=INFO
SESSION_COOKIE_SECURE=true
SESSION_LIFETIME_SECONDS=86400
