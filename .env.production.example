# Template only. Copy to .env.production, chmod 600; never deploy these placeholders.
APP_ENV=production
AEVYRA_DOMAIN=your-domain.example
IMAGE_TAG=local
POSTGRES_USER=aevyra
POSTGRES_DB=aevyra
POSTGRES_PASSWORD=
# URL-encode credentials; match POSTGRES_PASSWORD. Use a 32-byte random hex password.
DATABASE_URL=
REDIS_URL=redis://redis:6379/0
API_URL=http://api:8000
# Set the exact browser HTTPS origin for account POSTs; [] fails closed.
CORS_ORIGINS=[]
LOG_LEVEL=INFO
PAYMENT_PROVIDER=mock
REDEMPTION_CODE_PEPPER=REPLACE_WITH_SECURE_RANDOM_SECRET
SESSION_LIFETIME_SECONDS=86400
SESSION_COOKIE_SECURE=true
