# Template only. Copy to .env.production, chmod 600; never deploy these placeholders.
APP_ENV=production
AEVYRA_DOMAIN=your-domain.example
IMAGE_TAG=local
POSTGRES_USER=aevyra
POSTGRES_DB=aevyra
POSTGRES_PASSWORD=
# URL-encode credentials; match POSTGRES_PASSWORD. Use a 32-byte random hex password.
DATABASE_URL=
REDIS_URL=redis://redis:6379/0
API_URL=http://api:8000
# Set the exact browser HTTPS origin for account POSTs; [] fails closed.
CORS_ORIGINS=[]
LOG_LEVEL=INFO
PAYMENT_PROVIDER=mock
REDEMPTION_CODE_PEPPER=REPLACE_WITH_SECURE_RANDOM_SECRET
SESSION_LIFETIME_SECONDS=86400
SESSION_COOKIE_SECURE=true

# --- Private research (personal models, Owner research, native scoring) ---------------
# Off by default. Set true only for an operator-controlled deployment; also start the
# worker with `--profile research`. Research access is granted per user by the Owner.
RESEARCH_MODE=false
# Reviewed providers only; [] keeps every external/unreviewed provider unavailable.
ENABLED_MODEL_PROVIDERS=[]
# Private uploads/models live in the auvylen_private volume at /var/lib/auvylen
# (uploads/ and models/, owned by UID 10001). Restored Codespace models/ keep their layout:
# models/pretrained/ holds the reviewed MobileNetV3 ONNX encoder, models/custom/ the
# personal checkpoints.
# Optional limits (defaults shown are the application's own defaults):
# RESEARCH_MAX_PENDING=2
# RESEARCH_DAILY_LIMIT=50
# RESEARCH_MAX_RUNNING=1
# OWNER_MAX_PROJECTS=100
# OWNER_MAX_DATASETS=300
# OWNER_MAX_IMAGES=1000
# OWNER_STORAGE_MIB=2048
# OWNER_MAX_PAIRS=50000
# OWNER_MAX_MODELS=300
# OWNER_MAX_PENDING=4
# OWNER_DAILY_LIMIT=200
# OWNER_FRESH_AUTH_SECONDS=600
# JOB_LEASE_SECONDS=60
# STUDY_MAX_PHOTOS=200
# Phase 6 aesthetic model: keep false until docs/aesthetic-scoring.md release steps pass.
AESTHETIC_SCORING_ENABLED=false
AESTHETIC_MODEL_VERSION=
AESTHETIC_MANIFEST_SHA256=
# Unfinished web pages (aesthetic analysis, native preview) stay hidden (404) in production.
# Leave empty; set true only to show them again. Synthetic/mock pages never show here.
PREVIEW_FEATURES_ENABLED=
