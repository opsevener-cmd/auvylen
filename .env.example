# Development only. Replace credentials before any deployment.
API_ENVIRONMENT=development
# Deployment uses APP_ENV (takes precedence over API_ENVIRONMENT).
# For staging/production start with .env.production.example, not these dev defaults.
DATABASE_URL=postgresql+psycopg://aevyra:aevyra_dev_only@127.0.0.1:5432/aevyra
REDIS_URL=redis://127.0.0.1:6379/0
LOG_LEVEL=INFO
CORS_ORIGINS=["http://localhost:3000"]
# Server-side Next.js URL; never exposed as a browser environment variable.
API_URL=http://127.0.0.1:8000
POSTGRES_USER=aevyra
POSTGRES_PASSWORD=aevyra_dev_only
POSTGRES_DB=aevyra
# Only mock exists; direct checkout and synthetic execution are disabled in production.
PAYMENT_PROVIDER=mock
# Future adapters only. Leave empty; no credentials are requested or used.
# WECHAT_PAY_APP_ID=
# WECHAT_PAY_MERCHANT_ID=
# WECHAT_PAY_API_V3_KEY=
# WECHAT_PAY_CERTIFICATE_SERIAL=
# WECHAT_PAY_PRIVATE_KEY_PATH=
# ALIPAY_APP_ID=
# ALIPAY_PRIVATE_KEY_PATH=
# ALIPAY_PUBLIC_KEY_PATH=
## Required outside tests. Replace with secrets.token_hex(48); never commit the value.
## Back it up separately: changing it makes existing unused codes unredeemable.
REDEMPTION_CODE_PEPPER=REPLACE_WITH_SECURE_RANDOM_SECRET
SESSION_LIFETIME_SECONDS=86400
# true for any HTTPS deployment; staging/production enforce true.
SESSION_COOKIE_SECURE=false
