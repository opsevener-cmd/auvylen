encode zstd gzip
@preference_upload path /api/v1/research/preferences/datasets/*/images
request_body @preference_upload {
	max_size 6MB
}
@other_requests not path /api/v1/research/preferences/datasets/*/images
request_body @other_requests {
	max_size 1MB
}
header {
	-Server
	X-Content-Type-Options nosniff
	Referrer-Policy strict-origin-when-cross-origin
	X-Frame-Options DENY
}
@api path /api /api/* /health /ready
handle @api {
	reverse_proxy api:8000
}
handle {
	reverse_proxy web:3000
}
